{
  "headers": [
    {
      "source": "/((?!embed).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://members-api.parliament.uk https://thumb.wikimedia.org; connect-src 'self' https://xwrxaarxhlddbhbdbjmm.supabase.co https://api.postcodes.io https://elections.democracyclub.org.uk https://candidates.democracyclub.org.uk https://services1.arcgis.com https://environment.data.gov.uk https://data.police.uk https://api.ratings.food.gov.uk https://api.carbonintensity.org.uk; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/embed(.html)?",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://members-api.parliament.uk https://thumb.wikimedia.org; connect-src 'self' https://xwrxaarxhlddbhbdbjmm.supabase.co https://api.postcodes.io https://elections.democracyclub.org.uk https://candidates.democracyclub.org.uk https://services1.arcgis.com https://environment.data.gov.uk https://data.police.uk https://api.ratings.food.gov.uk https://api.carbonintensity.org.uk; frame-ancestors *; base-uri 'self'; form-action 'self'; object-src 'none'; frame-src 'none'; worker-src 'self'; manifest-src 'self'; media-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/calendar/(.*).ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/portraits/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(assets|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:view(about|accessibility|ageing|answers|appg|auditWatch|specialAdvisers|backbench|brexit|budget|business|byElections|cabinet|calculators|care|civilService|committeeReports|committees|compare|compareCouncils|compareSeats|constituency|constitution|consultations|corrections|councilComplaints|councilSpending|councillors|councils|crime|darkMoney|defence|departments|deprivation|devolved|digital|donors|economy|education|electionSpending|energy|environment|farming|flooding|followTheMoney|foreignInfluence|foreignPolicy|formerMps|funding|generalElection|getThingsDone|glossary|govContracts|health|history|honours|housing|howBudgetWorks|howElectionsWork|howLawMade|howPartyFundingWorks|howitworks|howtovote|immigration|indicators|inequality|inquiries|jobs|justice|list|lobbyingRegister|localElections|lords|lordsVotes|marginals|mayors|mediaLiteracy|methodology|ministerialMeetings|monarchy|mp|mpProfile|myArea|myBallot|myMP|nearYou|nhs|numbers|offices|parties|partyFinances|partymatch|petitions|planning|policeCommissioners|polling|population|prices|privacy|publicFinances|rankings|rates|rebels|regions|revolvingDoor|seatmap|settings|speakerWhipsClerks|spotMisleadingStats|standards|start|statutoryInstruments|tax|taxRates|teacher|terms|thinkTanks|thisWeek|timeline|topics|tracker|trade|transport|trust|union|upcoming|voting|watchdogs|watchlist|water|welfare|whatsnew|writtenQuestions)/:rest*",
      "destination": "/"
    },
    {
      "source": "/portraits/:id(\\d+).webp",
      "destination": "https://members-api.parliament.uk/api/Members/:id/Thumbnail"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "simple-politics.vercel.app"
        }
      ],
      "destination": "https://domesdaylive.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/p/tax",
      "destination": "/taxRates",
      "permanent": true
    },
    {
      "source": "/p/budget",
      "destination": "/taxRates/where",
      "permanent": true
    }
  ]
}
