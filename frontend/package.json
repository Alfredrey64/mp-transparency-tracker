{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:phone": "playwright test e2e/phone-layout.spec.js",
    "test:layout": "playwright test e2e/layout-audit.spec.js",
    "test:contrast": "playwright test e2e/contrast.spec.js",
    "test:site": "playwright test e2e/routing.spec.js e2e/offline.spec.js",
    "shots": "node e2e/shots.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:tax": "node scripts/check-tax-data.mjs",
    "prebuild": "node scripts/build-seo-pages.mjs",
    "check:speed": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.json",
    "check:site": "node scripts/check-site.mjs",
    "test:more": "playwright test e2e/accessibility.spec.js e2e/ballot.spec.js e2e/calculators.spec.js e2e/classCodes.spec.js e2e/compareCouncils.spec.js e2e/contrast.spec.js e2e/issue-tools.spec.js e2e/menu.spec.js e2e/myArea.spec.js e2e/polish.spec.js e2e/spin.spec.js e2e/teacher.spec.js e2e/welsh.spec.js e2e/welshPages.spec.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "motion": "^14.6.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.1.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.2"
  }
}
